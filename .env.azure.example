# Modèle des secrets du déploiement Azure.
# Copier en .env.azure (ignoré par git) puis remplir : cp .env.azure.example .env.azure
# Ne jamais commiter .env.azure, ni coller ses valeurs dans une capture, un log ou une IA.

# J4 : une URL factice suffit (le backend démarre sans base) : postgres://x:x@localhost:5432/none
# J5 : chaîne Neon, avec ?sslmode=require
DATABASE_URL=

# openssl rand -hex 32
JWT_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Doit rester NON VIDE (sinon le backend plante au démarrage : "Missing API key")
RESEND_API_KEY=re_factice
FROM_EMAIL=Quiz App <noreply@example.com>
